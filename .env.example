# Copy to .env.local; use URL/public key from your LOCAL Supabase status.
# Leave blank until configured. Service-role/provider secrets never belong in VITE variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_AUTH_ENABLED=false
VITE_MICROSOFT_AUTH_ENABLED=false
VITE_PHONE_AUTH_ENABLED=false
VITE_ENABLE_LEGACY_MODULES=false
VITE_ADMIN_HOSTNAME=
