# Backend only; do not copy these values into VITE variables or commit real secrets.
# Supabase injects SUPABASE_URL/SUPABASE_ANON_KEY/SUPABASE_SERVICE_ROLE_KEY for local/deployed functions.
APP_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
AI_PROVIDER_ENABLED=false
CRON_ENABLED=false
# Configure in a backend secret store only after authorization:
ANTHROPIC_API_KEY=
CRON_SECRET=
